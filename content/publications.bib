@inproceedings{geng2026stability,
  selected = {true},
  title = {Bridging the Stability-Expressivity Gap: Synthetic Data Scaling and Preference Alignment for Low-Resource Spoken Language Models},
  author = {Yizhong Geng and Yanliang Li and Jinghan Yang and Tianhan Jiang and Boxun An and Ya Li and Xiaoyu Shen*},
  year = {2026},
  month = may,
  booktitle = {International Conference on Machine Learning (ICML)},
  abstract = {Spoken Language Models (SLMs) have emerged as a promising paradigm for speech synthesis by bypassing explicit grapheme-to-phoneme pipelines. However, their effectiveness in low-resource languages remains limited by scarce transcribed speech. This work identifies the Stability-Expressivity Gap, where synthetic data improves phonetic accuracy while suppressing prosodic variability, and proposes Disentanglement-Guided Self-Alignment and Temperature-Driven Self-Critique to recover stability and expressivity in low-resource spoken language models.},
  description = {Studies synthetic data scaling for low-resource spoken language models and proposes self-alignment methods that improve stability and expressivity for Thai and Lao speech generation.},
  keywords = {Spoken Language Models, Text-to-Speech, Low-Resource Speech, Synthetic Data, Preference Alignment},
  pdf = {/papers/icml2026-yizhong-geng.pdf},
  url = {https://luoji.cn/static/multilantts-demo-main/}
}

@inproceedings{geng2026melocodec,
  selected = {true},
  title = {MeloCodec: Harnessing Melodic Priors for High-Fidelity Singing Voice Representation},
  author = {Yizhong Geng# and Wenxin Fu# and Kecan Mao# and Qifei Li# and Yingming Gao# and Ruimin Wang and Chunfeng Wang and Hao Li and Ya Li* and Wei Chen*},
  year = {2026},
  month = may,
  booktitle = {IEEE International Conference on Multimedia and Expo (ICME)},
  abstract = {Neural audio codecs serve as fundamental tokenizers for LLM-based audio generation. MeloCodec incorporates explicit melodic priors for singing voice representation through a Tokenize-then-Fuse paradigm and a robust two-stage training strategy, improving pitch consistency and enabling controllable pitch manipulation with minimal timbre degradation.},
  description = {Introduces a neural audio codec that embeds melodic structure into discrete representations for high-fidelity and controllable singing voice generation.},
  keywords = {Neural Audio Codec, Singing Voice Representation, Melodic Priors, Residual Vector Quantization},
  pdf = {/papers/icme2026-yizhong-geng.pdf},
  url = {https://anonymous.4open.science/api/repo/melocodec_demo-60EC/file/demo.html?v=42c197c7}
}

@inproceedings{bai2026hqsvc,
  selected = {true},
  title = {HQ-SVC: Towards High-Quality Zero-Shot Singing Voice Conversion in Low-Resource Scenarios},
  author = {Bingsong Bai and Yizhong Geng and Fengping Wang and Cong Wang and Puyuan Guo and Yingming Gao and Ya Li},
  year = {2026},
  month = jan,
  booktitle = {Proceedings of the AAAI Conference on Artificial Intelligence},
  volume = {40},
  number = {36},
  pages = {30013--30021},
  doi = {10.1609/aaai.v40i36.40249},
  abstract = {Zero-shot singing voice conversion transforms a source singer's timbre to an unseen target speaker's voice while preserving melodic content without fine-tuning. HQ-SVC extracts joint content and speaker features with a decoupled codec, enhances fidelity through pitch and volume modeling, and progressively refines outputs through differentiable signal processing and diffusion techniques.},
  description = {Presents an efficient zero-shot singing voice conversion system for low-resource scenarios, improving conversion quality and supporting voice super-resolution.},
  keywords = {Singing Voice Conversion, Zero-Shot Voice Conversion, Low-Resource Speech, Audio Super-Resolution},
  pdf = {https://arxiv.org/pdf/2511.08496},
  code = {https://huggingface.co/shawnpi/HQ-SVC},
  url = {https://shawnpi233.github.io/HQ-SVC-demo/}
}

@inproceedings{geng2025thai,
  selected = {true},
  title = {Scaling Under-Resourced TTS: A Data-Optimized Framework with Advanced Acoustic Modeling for Thai},
  author = {Yizhong Geng and Jizhuo Xu and Zeyu Liang and Jinghan Yang and Xiaoyi Shi and Xiaoyu Shen*},
  year = {2025},
  month = jul,
  booktitle = {Proceedings of the 63rd Annual Meeting of the Association for Computational Linguistics (Volume 6: Industry Track)},
  pages = {593--604},
  doi = {10.18653/v1/2025.acl-industry.42},
  abstract = {Text-to-speech technology has achieved impressive results for widely spoken languages, yet many under-resourced languages remain challenged by limited data and linguistic complexities. This work integrates a data-optimized framework with advanced acoustic modeling to build high-quality Thai TTS, supporting zero-shot voice cloning and improved performance across finance, healthcare, education, and law scenarios.},
  description = {Builds a scalable industrial Thai TTS framework with data construction, phoneme-tone modeling, and acoustic modeling for low-resource speech synthesis.},
  keywords = {Text-to-Speech, Low-Resource Languages, Thai, Acoustic Modeling, Zero-Shot Voice Cloning},
  pdf = {/papers/acl2025-yizhong-geng.pdf},
  url = {https://aclanthology.org/2025.acl-industry.42/}
}

@inproceedings{geng2025eegvc,
  selected = {false},
  title = {EEG-based Voice Conversion: Hearing the Voice of Your Brain},
  author = {Yizhong Geng and Wenxin Fu and Qihang Lu and Bingsong Bai and Cong Wang and Yingming Gao and Ya Li*},
  year = {2025},
  month = aug,
  booktitle = {INTERSPEECH},
  doi = {10.21437/Interspeech.2025-656},
  abstract = {The connection between EEG signals and human voice has gained significant attention, with studies demonstrating the feasibility of speech synthesis from EEG data. This work presents the first EEG-based zero-shot voice conversion system that converts speech into a target speaker's voice without prior target data by integrating an EEG feature extraction module with an alignment module to map EEG features to speaker-specific voice features.},
  description = {Proposes the first EEG-based zero-shot voice conversion framework, linking neural activity with speaker-specific voice characteristics for assistive communication and brain-computer interfaces.},
  keywords = {EEG, Zero-Shot Voice Conversion, Cross-Modal Generation, Speaker Embedding},
  pdf = {/papers/interspeech2025-yizhong-geng.pdf},
  url = {https://www.isca-archive.org/interspeech_2025/geng25b_interspeech.html}
}

